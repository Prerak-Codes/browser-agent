{
  "manifest_version": 3,
  "name": "Privacy Preserving AI Agent",
  "version": "1.0.0",
  "description": "Privacy-preserving screen analysis prototype",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}